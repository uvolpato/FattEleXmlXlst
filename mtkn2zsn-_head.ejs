<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title || 'Gestione Ordini' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body{background:#f5f6f8}
    .navbar-brand{font-weight:700}
    .toast-container{position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999}
    .btn-icon{padding:2px 7px;font-size:.8rem}
    .newtab-ico{opacity:.45;transition:opacity .15s}
    .newtab-ico:hover{opacity:1;color:#fff!important}
    /* ── Modali a dimensione fissa (3 taglie) ───────────────────────────── */
    .modal-fixed .modal-dialog{height:var(--mfx-h);max-width:var(--mfx-w);width:calc(100% - 2rem)}
    .modal-fixed.mfx-sm{--mfx-w:480px;--mfx-h:62vh}
    .modal-fixed.mfx-md{--mfx-w:840px;--mfx-h:76vh}
    .modal-fixed.mfx-lg{--mfx-w:1160px;--mfx-h:86vh}
    .modal-fixed .modal-content{height:100%;display:flex;flex-direction:column;overflow:hidden}
    .modal-fixed .modal-header,.modal-fixed .modal-footer{flex:0 0 auto}
    .modal-fixed .modal-body{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;overflow:hidden}
    .mfx-top{flex:0 0 auto;margin-bottom:.5rem}
    .mfx-bottom{flex:0 0 auto;margin-top:.6rem;border-top:1px solid #dee2e6;padding-top:.6rem}
    .mfx-scroll{flex:1 1 auto;min-height:0;overflow-y:auto}
    .mfx-scroll table{border-collapse:separate;border-spacing:0}
    .mfx-scroll table thead th{position:sticky;top:0;z-index:3;background:#e9ecef;box-shadow:inset 0 -1px 0 #adb5bd,inset 0 1px 0 #adb5bd}
    /* Tab dentro modali fisse: il pannello attivo riempie lo spazio, intestazione tabella sempre in cima */
    .modal-fixed .tab-content{flex:1 1 auto;min-height:0;display:flex}
    .modal-fixed .tab-content>.tab-pane{width:100%}
    .modal-fixed .tab-content>.tab-pane.active{display:flex;flex-direction:column;min-height:0}
    <%- extraCss || '' %>
  </style>
</head>
<body>
<nav class="navbar navbar-dark bg-dark px-3 py-2">
  <a class="navbar-brand d-flex align-items-center gap-2" href="/ordini">
    <% if (clienteConfig.clienteLogo) { %>
    <img src="/<%= clienteConfig.clienteLogo %>" alt="<%= clienteConfig.clienteLogoAlt %>"
         style="max-height:<%= clienteConfig.clienteLogoAltezzaNavbar %>px;max-width:120px;object-fit:contain;filter:brightness(0) invert(1)"
         onerror="this.style.display='none';this.nextElementSibling.style.display='inline-block'">
    <i class="bi bi-box-seam" style="display:none"></i>
    <% } else { %>
    <i class="bi bi-box-seam me-1"></i>
    <% } %>
    <%= clienteConfig.clienteNome %>
  </a>
  <div class="d-flex align-items-center gap-3">
    <a href="/ordini" class="nav-link text-white-50"><i class="bi bi-list-ul me-1"></i>Ordini</a>
    <div class="dropdown">
      <a class="nav-link text-white-50 dropdown-toggle d-flex align-items-center gap-1" href="#" role="button" data-bs-toggle="dropdown">
        <i class="bi bi-tools"></i>
        Strumenti
        <i class="bi bi-exclamation-triangle-fill text-warning" id="nav-err-icon"
           style="font-size:.85rem<%= erroriAperti > 0 ? '' : ';display:none' %>"
           title="<%= erroriAperti %> error<%= erroriAperti === 1 ? 'e' : 'i' %> non visto<%= erroriAperti === 1 ? '' : 'i' %>"></i>
      </a>
      <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
        <li>
          <a class="dropdown-item d-flex align-items-center justify-content-between" href="/errori">
            <span><i class="bi bi-exclamation-triangle me-2"></i>Errori</span>
            <span class="badge bg-warning text-dark ms-2" id="nav-err-count"
                  style="<%= erroriAperti > 0 ? '' : 'display:none' %>"><%= erroriAperti %></span>
          </a>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item" href="/ordini/upload"><i class="bi bi-file-earmark-pdf me-2"></i>Carica PDF</a></li>
        <li><a class="dropdown-item" href="/guida"><i class="bi bi-book me-2"></i>Guida</a></li>
        <li><a class="dropdown-item" href="#" id="toggle-help-fab"><i class="bi bi-question-circle me-2"></i>Pulsante aiuto</a></li>
        <% if (typeof currentUserRole !== 'undefined' && currentUserRole === 'admin') { %>
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item" href="/clienti"><i class="bi bi-people me-2"></i>Clienti</a></li>
        <li><a class="dropdown-item" href="/utenti"><i class="bi bi-person-gear me-2"></i>Utenti</a></li>
        <li><a class="dropdown-item" href="/audit"><i class="bi bi-journal-text me-2"></i>Audit</a></li>
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item" href="/articoli"><i class="bi bi-boxes me-2"></i>Articoli</a></li>
        <li><a class="dropdown-item" href="/codici-alias"><i class="bi bi-arrow-left-right me-2"></i>Codici Alias</a></li>
        <li><a class="dropdown-item" href="/giacenze"><i class="bi bi-box-seam me-2"></i>Giacenze</a></li>
        <li><a class="dropdown-item" href="/kit"><i class="bi bi-diagram-3 me-2"></i>Kit</a></li>
        <% } %>
      </ul>
    </div>
    <span class="text-white-50 small opacity-50" style="font-size:.72rem">v<%= appVersion %></span>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <span class="text-white-50 small"><i class="bi bi-person-fill me-1"></i><%= currentUser %></span>
    <form method="post" action="/logout" class="m-0">
      <button type="submit" class="btn btn-sm btn-outline-secondary text-white-50 border-secondary py-0 px-2" style="font-size:.78rem">
        <i class="bi bi-box-arrow-right me-1"></i>Esci
      </button>
    </form>
    <% } %>
  </div>
</nav>
